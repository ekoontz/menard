;; 
[{:g [(re-pattern "^(.*)$")       "$1"] ;; no change in inflection for singular form.
  :p [(re-pattern "^(.*)$")       "$1"] ;; no change in inflection for singular form.
  :u {:cat :noun
      :derivation {:runtime-noun-analysis {:morphology-noun-sing true}}
      :pronoun? false
      :regular? true
      :agr {:number :sing}}}

 {:g [(re-pattern "^(.*)$")       "$1"] ;; no change in inflection for singular form.
  :p [(re-pattern "^(.*)$")       "$1"] ;; no change in inflection for singular form.
  :u {:cat :noun
      :derivation {:runtime-noun-analysis {:morphology-noun-inherently-plural true}}
      :inherently-plural? true
      :pronoun? false
      :regular? true
      :agr {:number :plur}}}
 
 {:g [(re-pattern "^(.*[^aeiou])[y]$")  "$1ies"] ;; puppy     -> puppies
  :p [(re-pattern "^(.*)ies$")     "$1y"] 
  :u {:cat :noun
      :null? false
      :pronoun? false
      :derivation {:runtime-noun-analysis {:morphology-noun-plur-1 true}}
      :agr {:number :plur}
      :regular? true}}
      
 {:g [(re-pattern "^(.*)fe$")   "$1ves"] ;; life -> lives
  :p [(re-pattern "^(.*)ves$")  "$1fe"] 
  :u {:cat :noun
      :null? false
      :derivation {:runtime-noun-analysis {:morphology-noun-plur-2 true}}
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}
 
 {:g [(re-pattern "^(.*[cs]h)$")  "$1es"] ;;   ash   -> ashes
  :p [(re-pattern "^(.*[cs]h)es$")  "$1"]  
  :u {:cat :noun
      :null? false
      :derivation {:runtime-noun-analysis {:morphology-noun-plur-3 true}}
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}
      
 {:g [(re-pattern "^(.*[sx])$")  "$1es"] ;; class   -> classes
  :p [(re-pattern "^(.*)es$")    "$1"]   ;;
  :u {:cat :noun
      :null? false
      :pronoun? false
      :derivation {:runtime-noun-analysis {:morphology-noun-plur-4 true}}
      :agr {:number :plur}
      :regular? true}}
 
 {:g [(re-pattern "^(.*)$")       "$1s"] ;; dog     -> dogs
  :p [(re-pattern "^(.*)s$")      "$1"]  ;; dogs    -> dog
  :u {:cat :noun
      :null? false
      :derivation {:runtime-noun-analysis {:morphology-noun-plur-5 true}}
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}]

