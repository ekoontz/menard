[
 ;; singular
 ;; singular masculine

 ;; canonical form is identical to the masculine singular form:
 {:g [(re-pattern "^(.*)$")  "$1"] 
  :p [(re-pattern "(.*)$")   "$1"]
  :u {:cat :adjective
      :agr {:gender :masc
            :number :sing}}}

 ;; singular feminine
 ;; feminine singular: negra -> negro
 {:g [(re-pattern "^(.*)o$") "$1a"] 
  :p [(re-pattern "(.*)a$")  "$1o"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :sing}}}

 ;; for adjectives ending in -án: add 'a' suffix and remove accent
 ;; to make it feminine:
 {:g [(re-pattern "^(.*)(án)$") "$1ana"] 
  :p [(re-pattern "(.*)ana$")   "$1án"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :sing}}}

 ;; for adjectives ending in -és: add 'a' suffix and remove accent
 ;; to make it feminine:
 {:g [(re-pattern "^(.*)(és)$") "$1esa"] 
  :p [(re-pattern "(.*)esa$")   "$1és"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :sing}}}

  ;; for adjectives ending in -ín: add 'a' suffix and remove accent
 ;; to make it feminine:
 {:g [(re-pattern "^(.*)(ín)$") "$1ina"] 
  :p [(re-pattern "(.*)ina$")   "$1ín"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :sing}}}

  ;; for adjectives ending in -ón: add 'a' suffix and remove accent
 ;; to make it feminine:
 {:g [(re-pattern "^(.*)(ón)$") "$1ona"] 
  :p [(re-pattern "(.*)ona$")   "$1ón"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :sing}}}

  ;; for adjectives ending in -or: add 'a' suffix
 ;; to make it feminine:
 {:g [(re-pattern "^(.*)(or)$") "$1$2a"] 
  :p [(re-pattern "(.*)ora$")   "$1or"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :sing}}}
 
 ;; TODO: this should check every possible ending above for the :p section,
 ;; since parsing tries every rule, not just the first matching rule:
 ;; other endings don't change when becoming feminine singular:
 {:g [(re-pattern "^(.*)([^o])$") "$1$2"] 
  :p [(re-pattern "(.*)([^o])$")  "$1$2"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :sing}}}


 ;; plural
 ;; plural masculine
 
 ;; masculine plural: -n -z final does not change
 {:g [(re-pattern "^(.*[nz])$") "$1"] 
  :p [(re-pattern "(.*[nz])$")  "$1"]
  :u {:cat :adjective
      :agr {:gender :masc
            :number :plur}}}

 ;; otherwise: add -s for masculine plural
 {:g [(re-pattern "^(.*[^nz])$") "$1s"] 
  :p [(re-pattern "(.*[^nz])s$") "$1"]
  :u {:cat :adjective
      :agr {:gender :masc
            :number :plur}}}

 ;; plural feminine
 ;; feminine plural: -o adjectives:
 {:g [(re-pattern "^(.*)o$") "$1as"] 
  :p [(re-pattern "(.*)as$") "$1o"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :plur}}}

 ;; for adjectives ending in -án: add 'es' suffix and remove accent
 ;; to make it feminine:
 {:g [(re-pattern "^(.*)(án)$") "$1anes"] 
  :p [(re-pattern "(.*)anes$")  "$1án"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :plur}}}

 ;; for adjectives ending in -és: add 'es' suffix and remove accent
 ;; to make it feminine:
 {:g [(re-pattern "^(.*)(és)$") "$1esas"] 
  :p [(re-pattern "(.*)a$")     "$1"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :plur}}}

  ;; for adjectives ending in -ín: add 'es' suffix and remove accent
 ;; to make it feminine:
 {:g [(re-pattern "^(.*)(ín)$") "$1inas"] 
  :p [(re-pattern "(.*)a$")     "$1"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :plur}}}

  ;; for adjectives ending in -ón: add 'es' suffix and remove accent
 ;; to make it feminine:
 {:g [(re-pattern "^(.*)(ón)$") "$1onas"] 
  :p [(re-pattern "(.*)a$")     "$1"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :plur}}}

  ;; for adjectives ending in -or: add 'es' suffix
 ;; to make it feminine:
 {:g [(re-pattern "^(.*)(or)$") "$1$2es"] 
  :p [(re-pattern "(.*)a$")     "$1"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :plur}}}
 
  ;; feminine plural: -e,-l adjectives:
 {:g [(re-pattern "^(.*)([el])$") "$1$2s"] 
  :p [(re-pattern "(.*)([el])s$") "$1$2"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :plur}}}

  ;; feminine plural: -z, adjectives:
 {:g [(re-pattern "^(.*)(z)$") "$1ces"] 
  :p [(re-pattern "(.*)ces$")  "$1z"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :plur}}}

 ;; TODO: this should check every possible ending above for the :p section,
 ;; since parsing tries every rule, not just the first matching rule:
 ;; other endings don't change when becoming feminine plural:
 {:g [(re-pattern "^(.*)$") "$1"] 
  :p [(re-pattern "(.*)$")  "$1"]
  :u {:cat :adjective
      :agr {:gender :fem
            :number :plur}}}

 ]

 
