[
 ;; participio inflection

 ;; -ar verbs
 {:g [(re-pattern "^(.*)ar$")   "$1ado"] 
  :p [(re-pattern "^(.*)ado$")  "$1ar"] 
  :u {:cat :verb
      :infl :participio
      :reflexive? false}}

 {:g [(re-pattern "^(.*)arse$") "$1ado"] 
  :p [(re-pattern "^(.*)ado$")  "$1arse"] 
  :u {:cat :verb
      :infl :participio
      :reflexive? true}}

 
 ;; -er verbs
 {:g [(re-pattern "^(.*)er$")   "$1ido"] 
  :p [(re-pattern "^(.*)ido$")  "$1er"] 
  :u {:cat :verb
      :infl :participio
      :reflexive? false}}
 {:g [(re-pattern "^(.*)erse$") "$1ido"] 
  :p [(re-pattern "^(.*)ido$")  "$1erse"] 
  :u {:cat :verb
      :infl :participio
      :reflexive? true}}

 ;; -ir verbs
 {:g [(re-pattern "^(.*)ir$")   "$1ido"] 
  :p [(re-pattern "^(.*)ido$")  "$1ir"] 
  :u {:cat :verb
      :infl :participio
      :reflexive? false}}
 {:g [(re-pattern "^(.*)irse$") "$1ido"] 
  :p [(re-pattern "^(.*)ido$")  "$1irse"] 
  :u {:cat :verb
      :infl :participio
      :reflexive? true}}
 ]


