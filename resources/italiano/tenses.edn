;; babel.italiano.grammar/tenses, preserved verbatim.
;; NOTE: not wired to any grammar rule's :options, because menard's :options
;; must be a *symbol* (e.g. menard.español.tenses/finite-nonaux-tenses), which
;; would need a src/menard/italiano/tenses.cljc namespace.
{"conditional" {:sem {:tense :conditional}},
 "future" {:sem {:tense :future}},
 "imperfetto" {:sem {:aspect :progressive, :tense :past}},
 "passato" {:sem {:aspect :perfect, :tense :present}},
 "present progressive"
 {:sem {:aspect :progressive, :tense :present}},
 "present simple" {:sem {:aspect :simple, :tense :present}},
 "trapassato" {:sem {:aspect :pluperfect, :tense :past}}}
