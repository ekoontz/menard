[{:g [(re-pattern "^(.*)$")       "$1"]
  :p [(re-pattern "^(.*)$")       "$1"]
  :u {:cat :noun
      :inflection :null
      :null? true}}
 {:g [(re-pattern "^(.*)$")       "$1"]          ;; no change in inflection for singular form.
  :p [(re-pattern "^(.*)$")       "$1"]          ;; no change in inflection for singular form.
  :u {:cat :noun
      :null? false
      :pronoun? false
      :regular? true
      :agr {:number :sing}}}

 ;; if a singular noun ends in a consonant+vowel (except 'e' but including 'y'), then noun pluralization ends in -'s (apostrophe + s).
 ;; for parsing, we include both: ' and ’ as apostrophe-variants
 {:g [(re-pattern "([^aeiou])([aiouy])$")      "$1$2's"]       ;; baby  -> baby's
  :p [(re-pattern "([^aeiou])([aiouy])['’]s$") "$1$2"]        ;; baby's -> baby
  :u {:cat :noun
      :null? false
      :inflection :apostrophe-s
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}
 
 ;; if a singular noun ends in -heid, then noun pluralization ends in -heden:
 {:g [(re-pattern "heid$")  "heden"]           ;; mogelijkheid -> mogelijkheden
  :p [(re-pattern "heden$") "heid"]
  :u {:cat :noun
      :null? false
      :inflection :heid
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 ;; if a singular noun ends in -ooX, then noun pluralization ends in -oXen:
 ;; echtgenoot -> echtgenoten, bloemkool -> bloemkolen, boom -> bomen
 {:g [(re-pattern "oo([lmnt])$")  "o$1en"]
  :p [(re-pattern "o([lmnt])en$") "oo$1"]
  :u {:cat :noun
      :null? false
      :inflection :oot
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 ;; noun pluralization ending in -s:
 {:g [(re-pattern "([^aeiouy])(e|el|em|en|er|ie|oer|um)$")  "$1$2s" ]
  :p [(re-pattern "([^aeiouy])(e|el|em|en|er|ie|oer|um)s$") "$1$2"  ]
  ;;                                    tafels -> tafel 
  :u {:cat :noun
      :null? false
      :inflection :s
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}
 
 ;; this is a complicated pattern where, in pluralization, the
 ;; vowel shortens (aa->a) and the consonant lengthens (k->kk):
 ;; For now, only matching 'a' for the vowel and 'k' for the consonant,
 ;; but may generalize later if needed.
 {:g [(re-pattern "^(.*)([a])\\2([k])$")   "$1$2$3$3en"]    ;; zaak    -> zakken
  :p [(re-pattern "^(.*)([a])([k])\\3en$") "$1$2$2$3"]      ;; zakken  -> zaak
  :u {:cat :noun
      :null? false
      :inflection :repeat-consonant-shorten-vowel
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 {:g [(re-pattern "^(.*a)as$")    "$1zen"]       ;; baas   -> bazen
  :p [(re-pattern "^(.*)azen$")   "$1aas"] 
  :u {:cat :noun
      :null? false
      :inflection :s2z
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}
 
 ;; TODO: nouns end in 's' if they end in
 ;; "aar(d), -erd,-ier when referring to people" (F. p 55).
 {:g [(re-pattern "^(.*)aa(.)$")     "$1a$2en"]  ;; haar   -> haren
  :p [(re-pattern "^(.*)a(.)en$")    "$1aa$2"]   ;; haren -> haar
  :u {:cat :noun
      :null? false
      :inflection :repeated-vowel
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 {:g [(re-pattern "^(.*)ee(.)$")     "$1e$2en"]  ;; been   -> benen
  :p [(re-pattern "^(.*)e([nr])en$") "$1ee$2"]   ;; benen -> been
  :u {:cat :noun
      :null? false
      :inflection :repeated-vowel
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 ;; TODO: see what other consonants to add besides 'g' and 'p':
 {:g [(re-pattern "^(.*)oo([gp])$")  "$1o$2en"]  ;; oog -> ogen
  :p [(re-pattern "^(.*)o([gp])en$") "$1oo$2"]    ;; ogen -> oog
  :u {:cat :noun
      :null? false
      :inflection :repeated-vowel
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}
 
 {:g [(re-pattern "^(.*ui)s$")    "$1zen"]       ;; huis   -> huizen
  :p [(re-pattern "^(.*ui)zen$")  "$1s"] 
  :u {:cat :noun
      :null? false
      :inflection :s2z
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 {:g [(re-pattern "^(.*o)ns$")    "$1zen"]       ;; ons   -> onzen
  :p [(re-pattern "^(.*on)zen$")   "$1s"] 
  :u {:cat :noun
      :null? false
      :inflection :s2z
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 {:g [(re-pattern "^(.*ts)$")       "$1en"]      ;; fiets    -> fietsen
  :p [(re-pattern "^(.*ts)en$")     "$1"]
  :u {:cat :noun
      :null? false
      :inflection :tsen
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 ;; <bril,jas,kat,boodschap,man -> brillen, jassen,katten,boodschappen,mannen>
 ;; but         : tonijn        -> tonijnen, not *tonijnnen.
 {:g [(re-pattern "^(.*[^aeiou][aeiou])(n)$")    "$1$2$2en"] 
  :p [(re-pattern "^(.*[^aeiou][aeiou])(n)nen$") "$1$2"] 
  :u {:cat :noun
      :null? false
      :inflection :repeated-consonant
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 {:g [(re-pattern "^(.*[^aeiou][aeiou])(m)$")    "$1$2$2en"] 
  :p [(re-pattern "^(.*[^aeiou][aeiou])(m)men$") "$1$2"] 
  :u {:cat :noun
      :null? false
      :inflection :repeated-consonant
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 ;; plek,gesprek -> plekken,gesprekken
 {:g [(re-pattern "([lrst])([eou])k$")        "$1$2kken"]
  :p [(re-pattern "(.*)([lrst])([eou])kken$") "$1$2$3k"]
  :u {:cat :noun
      :null? false
      :inflection :repeated-k
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 ;; boodschap->boodschappen,
 ;; but exclude groep->groepen, not *groeppen:
 ;; TODO: generalize not with (.*a) but with
 ;; (consonant)(vowel) as we do with repeated 't'
 ;; in the next rule:
 {:g [(re-pattern "^(.*[aio])(p)$")    "$1$2$2en"] 
  :p [(re-pattern "^(.*[aio])(p)pen$") "$1$2"] 
  :u {:cat :noun
      :null? false
      :inflection ::repeated-consonant
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}
 {:g [(re-pattern "^(.*)(s)$")    "$1$2$2en"] 
  :p [(re-pattern "^(.*)(s)sen$") "$1$2"] 
  :u {:cat :noun
      :null? false
      :inflection :repeated-consonant
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 ;; bril -> brillen
 {;;      consonant  vowel   l    ->  double-l
  :g [(re-pattern "^(.*[^aeiou][aieou])(l)$")    "$1$2$2en"]
  ;;      consonant  vowel   tt   ->  single-t
  :p [(re-pattern "^(.*[^aeiou][aeiou])(l)len$") "$1$2"] 
  :u {:cat :noun
      :null? false
      :inflection :repeated-consonant
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}
 {;; bed -> bedden
  :g [(re-pattern "^(.*[^aeiou][aieou])(d)$")    "$1$2$2en"] 
  
  ;;      consonant  vowel   dd   ->  single-d
  :p [(re-pattern "^(.*[^aeiou][aeiou])(d)den$") "$1$2"] 
  :u {:cat :noun
      :null? false
      :inflection :repeated-consonant
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 {;;      consonant  vowel   t   ->   double-t
  :g [(re-pattern "^(.*[^aeiou][aieou])(t)$")    "$1$2$2en"] 
  
  ;;      consonant  vowel   tt   ->  single-t
  :p [(re-pattern "^(.*[^aeiou][aeiou])(t)ten$") "$1$2"] 
  :u {:cat :noun
      :null? false
      :inflection :repeated-consonant
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}
 
 ;; </jas,kat,boodschap,man -> jassen,katten,boodschappen,mannen>

 {:g [(re-pattern "^(.*)f$")    "$1ven"]         ;; druif   -> druiven
  :p [(re-pattern "^(.*)ven$")  "$1f"] 
  :u {:cat :noun
      :null? false
      :inflection :f2v
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 {:g [(re-pattern "^(.*)t$")    "$1ten"]         ;; opdracht    -> opdrachten
  :p [(re-pattern "^(.*)ten$")  "$1t"]
  :u {:cat :noun
      :null? false
      :inflection :ends-in-t
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 {:g [(re-pattern "^(.*ee)$")    "$1ën"]    ;; zee    -> zeeën
  :p [(re-pattern "^(.*)ën$")    "$1"]      ;; zeeën  -> zee
  :u {:cat :noun
      :null? false
      :inflection :umlaut-e
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 {:g [(re-pattern "^(.*[^st])$")    "$1en"]     ;; hond   -> honden
  :p [(re-pattern "^(.*[^st])en$")  "$1"]        ;; honden -> dog
  :u {:cat :noun
      :abbreviation? false
      :null? false
      :inflection :en
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 {:g [(re-pattern "(.*)$")      "$1's" ]
  :p [(re-pattern "(.*)[']s$")  "$1"  ]
  :u {:cat :noun
      :abbreviation? true
      :null? false
      :inflection :abbreviation
      :pronoun? false
      :agr {:number :plur}
      :regular? true}}

 ]

