[
 {:g [(re-pattern "^(.*)$")   "$1"] ;; werken -> werken
  :p [(re-pattern "^(.*)$")   "$1"] ;; werken -> werken
  :u {:cat :verb
      :finite? false
      :infl :infinitive}}

;; <F. p. 108>
;; inflection: present

 ;; 1st
 {:g [(re-pattern "^(.*g)gen$") "$1"]       ;; uitgeleggen -> uitgeleg
  :p [(re-pattern "^(.*)(.)$")  "$1$2$2en"] 
  :u {:cat :verb
      :finite? true
      :infl :present
      :agr {:person :1st
            :number :sing}}}
 {:g [(re-pattern "^(.*)en$") "$1"]        ;; werken -> werk
  :p [(re-pattern "^(.*)$")   "$1en"]      ;; werk -> werken 
  :u {:cat :verb
      :finite? true
      :infl :present
      :agr {:person :1st
            :number :sing}}}
 {:g [(re-pattern "^optr([e])den$") "optr$1$1d"]   ;; optreden -> treed
  :p [(re-pattern "^tr([e])\\1d$")   "optr$1den"]   ;; treed    -> optreden
  :u {:cat :verb
      :finite? true
      :separable? true
      :infl :present
      :agr {:person :1st
            :number :sing}}}
 {:g [(re-pattern "^(ver)g(e)t(en)$") "$1g$2$2t"]  ;; vergeten -> vergeet
  :p [(re-pattern "^(ver)g([e])\\2t$") "$1g$2ten"]  ;; vergeet  -> vergeten
  :u {:cat :verb
      :finite? true
      :infl :present
      :agr {:person :1st
            :number :sing}}}
 
 ;; 2nd
 {:g [(re-pattern "^(.*g)gen$") "$1d"]      ;; uitgeleggen -> uitgelegd
  :p [(re-pattern "^(.*)d$")    "$1gen"] 
  :u {:cat :verb
      :finite? true
      :infl :present
      :agr {:person :2nd
            :number :sing}}}
 {:g [(re-pattern "^(.*)en$") "$1t"]   ;; werken -> werkt
  :p [(re-pattern "^(.*)t$")  "$1en"] 
  :u {:cat :verb
      :finite? true
      :infl :present
      :agr {:person :2nd
            :number :sing}}}
 {:g [(re-pattern "^(.*)an$") "$1at"]   ;; slaan -> slaat
  :p [(re-pattern "^(.*)at$") "$1an"]   ;; slaat -> slaan
  :u {:cat :verb
      :finite? true
      :infl :present
      :agr {:person :2nd
            :number :sing}}}

 {:g [(re-pattern "^optr([e])den$") "optr$1$1dt"]    ;; optreden -> treedt
  :p [(re-pattern "^tr([e])\\1dt$")  "optr$1den"]     ;; treedt   -> optreden
  :u {:cat :verb
      :finite? true
      :separable? true
      :infl :present
      :agr {:person :2nd
            :number :sing}}}
 {:g [(re-pattern "^(ver)g(e)t(en)$") "$1g$2$2t"]  ;; vergeten -> vergeet
  :p [(re-pattern "^(ver)g([e])\\2t$") "$1g$2ten"]  ;; vergeet  -> vergeten
  :u {:cat :verb
      :finite? true
      :infl :present
      :agr {:person :2nd
            :number :sing}}}

 ;; 3rd
 {:g [(re-pattern "^(.*g)gen$") "$1d"]      ;; uitgeleggen -> uitgelegd
  :p [(re-pattern "^(.*)d$")    "$1gen"] 
  :u {:cat :verb
      :finite? true
      :infl :present
      :agr {:person :3rd
            :number :sing}}}
 {:g [(re-pattern "^(.*)en$") "$1t"]   ;; werken -> werkt
  :p [(re-pattern "^(.*)t$")  "$1en"]  ;; werkt  -> werken
  :u {:cat :verb
      :finite? true
      :infl :present
      :agr {:person :3rd
            :number :sing}}}
 {:g [(re-pattern "^(.*)an$") "$1at"]   ;; slaan -> slaat
  :p [(re-pattern "^(.*)at$") "$1an"]   ;; slaat -> slaan
  :u {:cat :verb
      :finite? true
      :infl :present
      :agr {:person :3rd
            :number :sing}}}
 {:g [(re-pattern "^optr([e])den$") "optr$1$1dt"]    ;; optreden -> treedt
  :p [(re-pattern "^tr([e])\\1dt$")  "optr$1den"]     ;; treedt   -> optreden
  :u {:cat :verb
      :finite? true
      :separable? true
      :infl :present
      :agr {:person :3rd
            :number :sing}}}

 {:g [(re-pattern "^(.*)$") "$1"]        ;; werken -> werken
  :p [(re-pattern "^(.*)$") "$1"] 
  :u {:cat :verb
      :finite? true
      :separable? false
      :infl :present
      :agr {:number :plur}}}
 {:g [(re-pattern "^op(.*)$") "$1"]        ;; optreden -> treden
  :p [(re-pattern "^(.*)$")   "op$1"]      ;; treden   -> optreden
  :u {:cat :verb
      :finite? true
      :separable? true
      :infl :present
      :agr {:number :plur}}}
 {:g [(re-pattern "^(ver)g(e)t(en)$") "$1g$2$2t"]  ;; vergeten -> vergeet
  :p [(re-pattern "^(ver)g([e])\\2t$") "$1g$2ten"]  ;; vergeet  -> vergeten
  :u {:cat :verb
      :finite? true
      :infl :present
      :agr {:person :3rd
            :number :sing}}}
 ;; </F>
 ]

