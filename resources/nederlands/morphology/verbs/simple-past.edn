      :finite? true
      :infl :past-simple
      :strong? :e-a-e
      :agr {:number :sing}}}
 {:g [(re-pattern "^(.*)ezen$") "$1azen"]
  :p [(re-pattern "^(.*)azen$") "$1ezen"]
