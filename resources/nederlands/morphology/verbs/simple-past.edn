[
 ;; F 47.1
 ;; <some doubled consonants get reduced to a single consonant>
 {;; wassen -> waste
  :g [(re-pattern "^(.*)([fks])\\2en$")      "$1$2te"]  
  :p [(re-pattern "^(.*)([fks])te$")        "$1$2$2en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :sing}
      :infl :past-simple}}

 {;; wassen -> wasten
  :g [(re-pattern "^(.*)([fks])\\2en$")      "$1$2ten"]
  :p [(re-pattern "^(.*)([fks])ten$")       "$1$2$2en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :plur}
      :infl :past-simple}}

 {;; bellen      -> belde
  ;; uitgeleggen -> uitgelegde
  ;; kennen      -> kenden
  :g [(re-pattern "^(.*)([^aeiou])\\2en$") "$1$2de"]
  ;; belde -> bellen, etc
  :p [(re-pattern "^(.*)([gln])de$")      "$1$2$2en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :sing}
      :infl :past-simple}}

 {;; bellen      -> belden
  ;; uitgeleggen -> uitgelegden
  ;; kennen      -> kenden, etc
  :g [(re-pattern "^(.*)([^aeiou])\\2en$") "$1$2den"]
  ;; belden      -> bellen, etc
  :p [(re-pattern "^(.*)([gln])den$")     "$1$2$2en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :plur}
      :infl :past-simple}}
 ;; </some doubled consonants get reduced to a single consonant>

 ;; <'t kofship vowel lengthening>
 ;; hopen -> hoopte
 {:g [(re-pattern "^(.*[^aeiou])([aieou])([tksp])en$") "$1$2$2$3te"]
  :p [(re-pattern "^(.*)([aieou])\\2([tksp])te$") "$1$2$3en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :sing}
      :infl :past-simple}}

  ;; hopen -> hoopten
 {:g [(re-pattern "^(.*[^aeiou])([aieou])([tksp])en$") "$1$2$2$3ten"]
  :p [(re-pattern "^(.*)([aieou])\\2([tksp])ten$") "$1$2$3en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :plur}
      :infl :past-simple}}

 {:g [(re-pattern "^(.*[^aeiou])([aieou])(ch)en$") "$1$2$2$3te"]
  :p [(re-pattern "^(.*)([aieou])\\2(ch)te$") "$1$2$3en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :sing}
      :infl :past-simple}}

 {:g [(re-pattern "^(.*[^aeiou])([aieou])(ch)en$") "$1$2$2$3ten"]
  :p [(re-pattern "^(.*)([aieou])\\2(ch)ten$") "$1$2$3en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :plur}
      :infl :past-simple}}
 ;; </'t kofship vowel lengthening>

 ;; <vowel lengthening: voiced to voiceless vrezen -> vreesen >
 {:g [(re-pattern "^(.*[^aeiou])([aieou])([z])en$") "$1$2$2sde"]
  :p [(re-pattern "^(.*[^aeiou])[s]de$") "$1zen"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :sing}
      :infl :past-simple}}

 {:g [(re-pattern "^(.*[^aeiou])([aieou])([z])en$") "$1$2$2$3den"]
  :p [(re-pattern "^(.*[^aieou])[s]den$") "$1zen"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :plur}
      :infl :past-simple}}
 ;; </vowel lengthening: voiced to voiceless vrezen -> vreesen >

 ;; <vowel lengthening>
 {:g [(re-pattern "^(.*[^aeiou])([aieou])([^aieou])en$")   "$1$2$2$3de"]
  :p [(re-pattern "^(.*[^aeiou])([aieou])\\2([^aeiou])de$") "$1$2$3en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :sing}
      :infl :past-simple}}

 {:g [(re-pattern "^(.*[^aeiou])([aieou])([^aieou])en$")    "$1$2$2$3den"]
  :p [(re-pattern "^(.*[^aeiou])([aieou])\\2([^aeiou])den$") "$1$2$3en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :plur}
      :infl :past-simple}}
 ;; </vowel lengthening>

 ;; <'t kofship>
 {:g [(re-pattern "^(.*[tksp])en$") "$1te"]
  :p [(re-pattern "^(.*[tksp])te$") "$1en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :sing}
      :infl :past-simple}}

 {:g [(re-pattern "^(.*[tksp])en$") "$1ten"]
  :p [(re-pattern "^(.*[tksp])ten$") "$1en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :plur}
      :infl :past-simple}}
 ;; </'t kofship>

 ;; voiced -> voiceless v->f
 {:g [(re-pattern "^(.*)ven$") "$1fde"]
  :p [(re-pattern "^(.*)fde$") "$1ven"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :sing}
      :infl :past-simple}}

 {:g [(re-pattern "^(.*)ven$")  "$1fden"]
  :p [(re-pattern "^(.*)fden$") "$1ven"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :plur}
      :infl :past-simple}}

 ;; voiced -> voiceless z->s
 ;; reizen -> reisde
 {:g [(re-pattern "^(.*)zen$") "$1sde"]
  :p [(re-pattern "^(.*)sde$") "$1zen"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :sing}
      :infl :past-simple}}

 {:g [(re-pattern "^(.*)zen$")  "$1sden"]
  :p [(re-pattern "^(.*)sden$") "$1zen"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :plur}
      :infl :past-simple}}
  
 ;; <default weak>
 {:g [(re-pattern "^(.*[^tksp])en$") "$1de"]
  :p [(re-pattern "^(.*[^tksp])de$") "$1en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :sing}
      :infl :past-simple}}

 {:g [(re-pattern "^(.*[^tksp])en$")  "$1den"]
  :p [(re-pattern "^(.*[^tksp])den$") "$1en"]
  :u {:cat :verb
      :finite? true
      :strong? false
      :agr {:number :plur}
      :infl :past-simple}}
 ;; </default weak>

 ;; <strong>
 ;; a -> oe -> a
 ;; dragen <-> droeg
 {:g [(re-pattern "^(.*)a(.)en$") "$1oe$2"]
  :p [(re-pattern "^(.*)oe(.)$")  "$1a$2en"]
  :u {:cat :verb
      :finite? true
      :infl :past-simple
      :strong? :a-oe-a
      :agr {:number :sing}}}
 ;; dragen <-> droegen
 {:g [(re-pattern "^(.*)a(.)en$") "$1oe$2en"]
  :p [(re-pattern "^(.*)oe(.)en$")  "$1a$2en"]
  :u {:cat :verb
      :finite? true
      :infl :past-simple
      :strong? :a-oe-a
      :agr {:number :plur}}}
 
 ;; <a – ie – a>
 ;; blazen <-> blies
 {:g [(re-pattern "^(.*)azen$") "$1ies"]
  :p [(re-pattern "^(.*)ies$")  "$1azen"]
  :u {:cat :verb
      :finite? true
      :infl :past-simple
      :strong? :a-ie-a
      :agr {:number :sing}}}
 ;; blazen <-> bliezen
 {:g [(re-pattern "^(.*)azen$")  "$1iezen"]
  :p [(re-pattern "^(.*)iezen$") "$1azen"]
  :u {:cat :verb
      :finite? true
      :infl :past-simple
      :strong? :a-ie-a
      :agr {:number :plur}}}

 ;; laten <-> liet; slapen <-> sliep
 {:g [(re-pattern "^(.*)a([pt])en$") "$1ie$2"]
  :p [(re-pattern "^(.*)ie([pt])$")  "$1a$2en"]
  :u {:cat :verb
      :finite? true
      :infl :past-simple
      :strong? :a-ie-a
      :agr {:number :sing}}}
 ;; laten <-> lieten; slapen <-> sliep
 {:g [(re-pattern "^(.*)a([pt])en$")  "$1ie$2en"]
  :p [(re-pattern "^(.*)ie([pt])en$") "$1a$2en"]
  :u {:cat :verb
      :finite? true
      :infl :past-simple
      :strong? :a-ie-a
      :agr {:number :plur}}}

 ;; vallen <-> viel
 {:g [(re-pattern "^(.*)a(l)len$") "$1ie$2"]
  :p [(re-pattern "^(.*)ie(l)$")   "$1a$2$2en"]
  :u {:cat :verb
      :finite? true
      :infl :past-simple
      :strong? :a-ie-a
      :agr {:number :sing}}}
 ;; vallen <-> vielen
 {:g [(re-pattern "^(.*)a(l)len$") "$1ie$2en"]
  :p [(re-pattern "^(.*)ie(l)en$") "$1a$2$2en"]
  :u {:cat :verb
      :finite? true
      :infl :past-simple
      :strong? :a-ie-a
      :agr {:number :plur}}}
 ;; </a – ie - a>

 ;; <e-a-e>
 ;; TODO: add separable/non-separable for all verbs.
 ;; So far, only have it for e-a-e below.
 ;; e-a-e,singular,non-separable
 {:g [(re-pattern "^(.*)e([dt])en$") "$1a$2"]
  :p [(re-pattern "^(.*)a([dt])$")   "$1e$2en"]
  :u {:cat :verb
      :finite? true
      :separable? false
      :infl :past-simple
      :strong? :e-a-e
      :agr {:number :sing}}}

 ;; e-a-e,singular,separable
 {:g [(re-pattern "^op(.*)e([dt])en$") "$1a$2"]
  :p [(re-pattern "^(.*)a([dt])$")     "op$1e$2en"]
  :u {:cat :verb
      :finite? true
      :separable? true
      :infl :past-simple
      :strong? :e-a-e
      :agr {:number :sing}}}

 ;; e-a-e,plural,non-separable
 {:g [(re-pattern "^(.*)e([dt])en$") "$1a$2en"]
  :p [(re-pattern "^(.*)a([dt])en$") "$1e$2en"]
  :u {:cat :verb
      :finite? true
      :separable? false
      :infl :past-simple
      :strong? :e-a-e
      :agr {:number :plur}}}
 ;; e-a-e,plural,separable
 {:g [(re-pattern "^op(.*)e([dt])en$") "$1a$2en"]
  :p [(re-pattern "^(.*)a([dt])en$")   "op$1e$2en"]
  :u {:cat :verb
      :finite? true
      :separable? true
      :infl :past-simple
      :strong? :e-a-e
      :agr {:number :plur}}}

 {:g [(re-pattern "^(.*)ezen$") "$1as"]
  :p [(re-pattern "^(.*)as$")   "$1ezen"]
